import QtQuick 1.0
import Sky     1.0

CursorSvg
{
    //---------------------------------------------------------------------------------------------
    // Properties
    //---------------------------------------------------------------------------------------------

    /* read */ property bool active: false

    //---------------------------------------------------------------------------------------------
    // Settings
    //---------------------------------------------------------------------------------------------

    width: st.dp64

    visible: (sk.cursorVisible && window.isEntered && active)

    source: (active) ? pGetSource(window.mouseCursor) : ""

    //---------------------------------------------------------------------------------------------
    // Functions
    //---------------------------------------------------------------------------------------------

    function toggle()
    {
        active = !(active);

        var shapes = [ Qt.ArrowCursor,    Qt.PointingHandCursor, Qt.IBeamCursor,
                       Qt.OpenHandCursor, Qt.ClosedHandCursor,   Qt.CrossCursor,
                       Qt.DragCopyCursor ];

        for (var i = 0; i < shapes.length; i++)
        {
            if (active)
            {
                window.registerCursorUrl(shapes[i], dataBlank);
            }
            else window.unregisterCursor(shapes[i]);
        }
    }

    //---------------------------------------------------------------------------------------------
    // Private

    function pGetSource(shape)
    {
        if      (shape == Qt.ArrowCursor)        return dataArrow;
        else if (shape == Qt.PointingHandCursor) return dataHand;
        else if (shape == Qt.IBeamCursor)        return dataBeam;
        else if (shape == Qt.OpenHandCursor)     return dataHandOpen;
        else if (shape == Qt.ClosedHandCursor)   return dataHandClosed;
        else if (shape == Qt.CrossCursor)        return dataCross;
        else if (shape == Qt.DragCopyCursor)     return dataCopy;
        else                                     return "";
    }

    //---------------------------------------------------------------------------------------------
    // Data
    //---------------------------------------------------------------------------------------------

    // blank.svg
    property string dataBlank: "image://data:image/svg;base64,"

    // arrow.svg
    property string dataArrow: "image://data:image/svg;base64,"

    // hand.svg
    property string dataHand: "image://data:image/svg;base64,"

    // beam.svg
    property string dataBeam: "image://data:image/svg;base64,"

    // hand-open.svg
    property string dataHandOpen: "image://data:image/svg;base64,"

    // hand-closed.svg
    property string dataHandClosed: "image://data:image/svg;base64,"

    // cross.svg
    property string dataCross: "image://data:image/svg;base64,"

    // copy.svg
    property string dataCopy: "image://data:image/svg;base64,"
}
